# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# YOUTUBE_API_KEY: Optional YouTube Data API v3 key
YOUTUBE_API_KEY=""

# GOOGLE_MAPS_API_KEY: Optional Google Maps API key
GOOGLE_MAPS_API_KEY=""

# CALLING_API_KEY: Optional telecom / calling integration API key
CALLING_API_KEY=""

# CAMERA_API_KEY: Optional camera computer vision API key
CAMERA_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
