{
  "name": "jarvis-voice-assistant",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "J.A.R.V.I.S. — Iron Man style AI Voice Assistant with system app control",
  "scripts": {
    "dev": "vite",
